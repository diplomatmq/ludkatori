# Токен бота от @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ID владельца бота (для доступа к настройкам)
ADMIN_ID=793216884

# ID чата, где работает бот (бот будет реагировать на 🎰 ТОЛЬКО в этом чате)
# Админ-панель (/start, /admin, /gifts) работает в личке с ботом
# Чтобы узнать ID чата: добавь бота в чат и отправь любое сообщение,
# в логах бота будет написан chat_id
# Формат для групп/каналов: -1002345678901 (начинается с минуса)
ALLOWED_CHAT_ID=-1002345678901
